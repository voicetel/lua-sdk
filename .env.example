# Copy to `.env` and fill in. The integration spec (spec/integration_spec.lua)
# reads these and runs against the live API in read-only mode. Without them,
# integration tests are skipped (marked pending).

# 10-digit VoiceTel account username (no dashes or spaces).
VOICETEL_USERNAME=1000000001

# Account password. After any password change, the previously-issued API key
# is invalidated — login() will produce a fresh one.
VOICETEL_PASSWORD=hunter2

# Optional. Override the API endpoint (e.g. a staging environment).
# Defaults to https://api.voicetel.com when unset.
# VOICETEL_BASE_URL=https://api.voicetel.com
